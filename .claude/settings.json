{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__733e0d99-31e4-4160-9c89-e998d4df3c6f__notion-fetch",
      "mcp__733e0d99-31e4-4160-9c89-e998d4df3c6f__notion-search",
      "Bash(python dd_protection.py:*)",
      "Bash(python scripts/verify_lock_anchors.py:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(python scripts/gate_manifest.py:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_shell_command.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_s2_runs.py\" claude-hook"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_operator_acts.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_open_verification_record.py\""
          }
        ]
      },
      {
        "matcher": "mcp__github__(push_files|create_or_update_file|delete_file|update_pull_request_branch|actions_run_trigger)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_s2_runs.py\" claude-hook"
          }
        ]
      },
      {
        "matcher": "mcp__github__(merge_pull_request|enable_pr_auto_merge)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_operator_acts.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/lock_event_hook.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/sync_skills_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session_divergence_hook.py\""
          },
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR/ops\" python -m sentinel --activity-decision-line"
          }
        ]
      }
    ]
  }
}
