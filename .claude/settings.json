{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/verify_lock_anchors.py:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(python scripts/gate_manifest.py:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)"
    ],
    "deny": [
      "Read(~/.fly/**)",
      "Read(~/.azure/**)",
      "Read(~/AppData/Roaming/gcloud/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.ssh/**)",
      "Read(//**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_shell_command.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_operator_acts.py\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_operator_acts.py\""
          }
        ]
      },
      {
        "matcher": "mcp__github__(merge_pull_request|enable_pr_auto_merge)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guard_operator_acts.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/lock_event_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session_divergence_hook.py\""
          }
        ]
      }
    ]
  }
}
