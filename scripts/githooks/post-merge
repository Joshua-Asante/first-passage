#!/bin/sh
# Post-merge notice. It cannot undo a merge, so it only warns. Its one check is
# incoming Pine-pin provenance (below). The SESSIONS.md debris repair went with
# SESSIONS.md in the 2026-11 governance cut.
ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$ROOT" || exit 0

# A post-merge notice cannot undo the merge. Expose environment failures before
# the advisory checks suppress their normal diagnostics or mutate session prose.
if ! python -I scripts/fp.py doctor >/dev/null; then
  echo "WARNING: post-merge checks did not run; repair the operations environment." >&2
  exit 0
fi

# Incoming Pine-pin provenance (2026-07-31). `.pine` is gitignored, so a pin
# authored on a disposable checkout (cloud agent / runner) is unverifiable the
# moment that machine is torn down — the bad8068d... case, where the "active
# working edition" had to be reconstructed from its predecessor.
#
# The pre-commit limb never sees this case (a fresh cloud-agent clone has no
# hooks installed). The PR job (.github/workflows/manifest-check.yml
# pine-pin-provenance) is now ALSO live (verified 2026-08-19, Q-GATESTACK-1
# Limb-D — GitHub Actions has run for real since the 2026-08-15 public
# transition) and catches this class at PR time, before the bytes are gone —
# this post-merge limb is the backstop for anything that job's checkout-based
# view can miss, not the only detection point anymore. Neither limb blocks:
# main requires a PR and only the `skills (3.12)` check (Q-GATESTACK-1 addendum).
#
# It CANNOT block — the pin is already committed upstream and the bytes are
# already gone. Detection is still worth having: acting now, while the authoring
# PR is fresh, is the difference between re-pinning from a source that still
# exists and reconstructing one that does not.
if git rev-parse --verify -q ORIG_HEAD >/dev/null; then
  if ! python -I scripts/fp.py python scripts/check_pine_manifest.py --check-pin-provenance --base ORIG_HEAD 2>/dev/null; then
    echo ""
    echo "WARNING: this merge brought in a Pine pin made on a disposable checkout."
    echo "         Those bytes are gitignored and are almost certainly already lost."
    echo "         Do NOT delete or weaken the pin. While the authoring PR is still"
    echo "         fresh, recover the .pine from it and re-pin from THIS machine:"
    echo "           python -I scripts/fp.py python scripts/check_pine_manifest.py --check-pin-provenance --base ORIG_HEAD"
    echo "         If the bytes are gone, reconstruct from the predecessor edition and"
    echo "         record it as a reconstruction, not a recovery (cf. bad8068d...)."
    echo ""
  fi
fi

exit 0
